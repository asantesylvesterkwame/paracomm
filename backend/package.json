{
	"name": "paracomm-backend",
	"description": "Paracomm API on Cloudflare Workers with Hono",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"@clerk/backend": "^3.16.4",
		"@hono/clerk-auth": "^3.1.1",
		"@hono/zod-validator": "^0.9.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.11.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.3",
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "9.39.2",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"wrangler": "4.88.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply paracomm --local",
		"db:migrate:remote": "wrangler d1 migrations apply paracomm --remote",
		"deploy": "wrangler deploy",
		"dev": "vite --port 8788",
		"lint": "eslint .",
		"preview": "npm run build && vite preview"
	},
	"type": "module"
}
