{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paracomm-backend",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "upload_source_maps": true,
  "kv_namespaces": [
    {
      "binding": "LIVE_QUOTA",
      "id": "a66b85132c504573a533d17cb61e3c20"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_DO",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paracomm",
      "database_id": "841bf273-3e24-4315-a88b-7cb7182d7161",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "LIVE_RPM",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "CHAT_DAILY_CHAR_BUDGET": "20000",
    "CLERK_PUBLISHABLE_KEY": "pk_test_c2V0dGxlZC1yYWJiaXQtNTcuY2xlcmsuYWNjb3VudHMuZGV2JA",
    "DAILY_CHAR_BUDGET": "15000",
    "TRANSLATION_MODEL": "gemini-3.6-flash",
    "TTS_MODEL": "gemini-3.1-flash-tts-preview",
    "TTS_VOICE": "Kore",
    "CORS_ORIGINS": "http://localhost:5173,https://paracomm.intelligentson17.workers.dev"
  }
}
